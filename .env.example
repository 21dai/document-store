# Configuración de la aplicación
APP_NAME=document-store
APP_VERSION=0.1.0
DEBUG=false

# Servidor HTTP
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1

# MongoDB (sin credenciales reales en el repositorio)
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=document_store
# Timeout en milisegundos para conectar y seleccionar el servidor
DATABASE_TIMEOUT_MS=3000
