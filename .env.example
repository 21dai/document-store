# Configuración de la aplicación
APP_NAME=document-store
APP_VERSION=0.2.0
DEBUG=false

# Servidor HTTP
HOST=0.0.0.0
PORT=8000
# Segundos que uvicorn espera las requests en curso al recibir SIGTERM.
# Menor que el stop_grace_period del compose (15 s).
GRACEFUL_SHUTDOWN_SECONDS=10

# API
API_V1_PREFIX=/api/v1

# MongoDB (sin credenciales reales en el repositorio)
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=document_store
# Timeout en milisegundos para conectar y seleccionar el servidor
DATABASE_TIMEOUT_MS=3000

# Cache de documentos en Redis (cache-aside). Vacio = sin cache.
# En el stack: redis://:<clave>@redis:6379/0
REDIS_URL=
# Segundos que dura cada documento en el cache
CACHE_TTL_SECONDS=300
# Timeout en milisegundos de Redis: si no responde, se lee de MongoDB
REDIS_TIMEOUT_MS=500
